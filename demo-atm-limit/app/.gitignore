node_modules/
dist/
# Regenerated by scripts/prerender.mts on every dev/build — 668 KB of
# derived text (highlighted source + captured run artefacts), not source.
src/generated/
# Rendered narration mp3s (scripts/render-narration.mts) — not committed
# until Petr has chosen a voice and signed off on the spoken text (see
# README's "Spoken narration" section: XTTS-v2's weights are CPML
# non-commercial). public/narration/.gitkeep keeps the directory itself
# tracked so a fresh checkout has somewhere to render into.
public/narration/*
!public/narration/.gitkeep
