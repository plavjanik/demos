    1     //DOGECOB  JOB  CLASS=A,MSGCLASS=H,MSGLEVEL=(1,1),NOTIFY=HERC02,        JOB   38
          //            USER=HERC02,PASSWORD=         GENERATED BY IKJEFF10
    2     //JOBPROC  DD DSN=HERC02.KICKSSYS.V1R5M0.PROCLIB,DISP=SHR
          *** DOGE SEND MONEYS - compile and link DOGESEND only
    3     //DOGESEND EXEC K2KCOBCL
    4     XXK2KCOBCL PROC SOUT='*',ZOUT='Z',
          XX            UNT=SYSDA,
          XX            KICKSYS='HERC02.KICKSSYS',
          XX            KIKSUSR='HERC02.KICKS',
          XX            VER=V1R5M0,
          XX            CBLPARM='SUPMAP,DMAP,CLIST'
          ***
          ***   PROC FOR MVT ANSI COBOL
          ***        AS INSTALLED ON MVS38J TURNKEY
          ***   NON-LE COMPILER -- RUNS TWICE FOR 'LENGTH OF'...
          ***   WORKS WITH KICKS
          ***
          *** - copy input for pp1 & pp2
    5     XXCOPY   EXEC PGM=IEBGENER
    6     XXSYSPRINT DD SYSOUT=&ZOUT
    7     XXSYSIN    DD DUMMY
    8     XXSYSUT2   DD DSN=&&PPIN,DISP=(,PASS),UNIT=SYSDA,
          XX         SPACE=(TRK,(90,15),RLSE)
    9     //COPY.SYSUT1 DD DISP=SHR,DSN=HERC02.DOGECICS(DOGESEND)
          X/SYSUT1   DD DSN=&KIKSUSR..&VER..COBCOPY(&VER),DISP=SHR
          ***
          *** - first pp, make input for first cob
   10     XXPP1    EXEC PGM=KIKPPCOB,
          XX            PARM='-v -t -dmapin1'
   11     XXSTEPLIB  DD DSN=&KICKSYS..&VER..SKIKLOAD,DISP=SHR
   12     XXSYSPRINT DD DISP=(,PASS),UNIT=&UNT,SPACE=(800,(500,100),RLSE),
          XX            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
   13     XXSYSTERM  DD SYSOUT=&SOUT,DCB=(BLKSIZE=120,RECFM=F)
   14     XXSYSUDUMP DD SYSOUT=&SOUT
   15     XXSYSLIB   DD DISP=SHR,DSN=&KIKSUSR..&VER..COBCOPY
   16     XX         DD DISP=SHR,DSN=&KICKSYS..&VER..COBCOPY
   17     XXSYSIN    DD DSN=&&PPIN,DISP=(OLD,PASS)
          ***
          *** - first cob, generate dmap
   18     XXCOB1   EXEC PGM=IKFCBL00,
          XX            REGION=4096K,
          XX            COND=(5,LT),
          XX PARM='DMAP,SOURCE,NOCLIST,NODECK,NOLOAD,SIZE=2048K,BUF=1024K,LIB'
   19     XXSYSPRINT DD DISP=(,PASS),UNIT=&UNT,SPACE=(1210,(500,100),RLSE),
          XX            DCB=(RECFM=FB,LRECL=121,BLKSIZE=1210)
   20     XXSYSPUNCH DD DUMMY
   21     XXSYSLIB   DD DISP=SHR,DSN=&KIKSUSR..&VER..COBCOPY
   22     XX         DD DISP=SHR,DSN=&KICKSYS..&VER..COBCOPY
   23     XXSYSLIN   DD UNIT=&UNT,SPACE=(80,(250,100)),DISP=(MOD,DELETE)
   24     XXSYSUT1   DD UNIT=&UNT,SPACE=(460,(350,100))
   25     XXSYSUT2   DD UNIT=&UNT,SPACE=(460,(350,100))
   26     XXSYSUT3   DD UNIT=&UNT,SPACE=(460,(350,100))
   27     XXSYSUT4   DD UNIT=&UNT,SPACE=(460,(350,100))
   28     XXSYSIN    DD DISP=(OLD,DELETE),DSN=*.PP1.SYSPRINT
          ***
          *** - 2nd pp, use dmap for LENGTH's, make input to 2nd cob
   29     XXPP2    EXEC PGM=KIKPPCOB,COND=((5,LT,PP1),(12,LT,COB1)),
          XX            PARM='-t -dmapin2'
   30     XXSTEPLIB  DD DSN=&KICKSYS..&VER..SKIKLOAD,DISP=SHR
   31     XXSYSPRINT DD DISP=(,PASS),UNIT=&UNT,SPACE=(800,(500,100),RLSE),
          XX            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
   32     XXSYSTERM  DD SYSOUT=&SOUT,DCB=(BLKSIZE=120,RECFM=F)
   33     XXSYSUDUMP DD SYSOUT=&SOUT
   34     XXSYSLIB   DD DISP=SHR,DSN=&KIKSUSR..&VER..COBCOPY
   35     XX         DD DISP=SHR,DSN=&KICKSYS..&VER..COBCOPY
   36     XXDMAPIN   DD DISP=(OLD,DELETE),DSN=*.COB1.SYSPRINT
   37     XXSYSIN    DD DSN=&&PPIN,DISP=(OLD,DELETE)
          ***
          *** - 2nd cob, make object deck for linker
   38     XXCOB2   EXEC PGM=IKFCBL00,
          XX            REGION=4096K,
          XX            COND=(5,LT),
          XX            PARM='NODECK,LOAD,SIZE=2048K,BUF=1024K,&CBLPARM,LIB'
   39     XXSYSPRINT DD SYSOUT=&SOUT
   40     XXSYSPUNCH DD DUMMY
   41     XXSYSLIB   DD DISP=SHR,DSN=&KIKSUSR..&VER..COBCOPY
   42     XX         DD DISP=SHR,DSN=&KICKSYS..&VER..COBCOPY
   43     XXSYSLIN   DD UNIT=&UNT,SPACE=(80,(250,100)),DISP=(MOD,PASS)
   44     XXSYSUT1   DD UNIT=&UNT,SPACE=(460,(350,100))
   45     XXSYSUT2   DD UNIT=&UNT,SPACE=(460,(350,100))
   46     XXSYSUT3   DD UNIT=&UNT,SPACE=(460,(350,100))
   47     XXSYSUT4   DD UNIT=&UNT,SPACE=(460,(350,100))
   48     XXSYSIN    DD DISP=(OLD,DELETE),DSN=*.PP2.SYSPRINT
          ***
   49     XXLKED   EXEC PGM=IEWL,
          XX            COND=(5,LT),
          XX            PARM='XREF,LIST,LET,MAP'
   50     XXSYSPRINT DD SYSOUT=&SOUT
   51     XXSYSLIB   DD DISP=SHR,DSN=SYS1.COBLIB
   52     XXSYSLMOD  DD DISP=SHR,DSN=&KIKSUSR..&VER..KIKRPL
   53     XXSYSLIN   DD DISP=(OLD,DELETE),DSN=*.COB2.SYSLIN
   54     XX         DD DDNAME=SYSIN
   55     XXSYSUT1   DD UNIT=(SYSDA,SEP=(SYSLMOD,SYSLIN)),
          XX         SPACE=(1024,(200,20))
   56     XXSKIKLOAD DD DISP=SHR,DSN=&KICKSYS..&VER..SKIKLOAD
   57     XXKIKRPL   DD DISP=SHR,DSN=&KICKSYS..&VER..KIKRPL
   58     //LKED.SYSIN DD *
          X/SYSIN    DD DUMMY
  STMT NO. MESSAGE
